{
  "name": "symbola-effect-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.packages.json",
    "check": "pnpm run format:check && pnpm run lint && pnpm run codegen:check && pnpm run build && pnpm run package:check && pnpm run test",
    "changeset-publish": "pnpm run build && pnpm run package:check && changeset publish --tag beta",
    "codegen": "pnpm --filter @symbola/effect-codegen codegen",
    "codegen:check": "pnpm --filter @symbola/effect-codegen codegen:check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings",
    "package:check": "pnpm run version:check && node ./scripts/checkPackages.ts",
    "test": "vitest run --project unit",
    "typecheck": "pnpm run build",
    "version:bump": "node ./scripts/syncEffectVersion.ts --bump-symbola",
    "version:check": "node ./scripts/syncEffectVersion.ts --check",
    "version:sync": "node ./scripts/syncEffectVersion.ts --write"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/vitest": "catalog:",
    "@fast-check/vitest": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.19.0"
}
