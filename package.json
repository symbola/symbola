{
  "name": "symbola-effect-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.packages.json",
    "check": "pnpm run format:check && pnpm run lint && pnpm run build && pnpm run codegen:check && pnpm run test",
    "changeset-publish": "pnpm run build && changeset publish",
    "changeset-version": "changeset version",
    "codegen": "pnpm --filter @symbola/effect-codegen codegen",
    "codegen:check": "pnpm --filter @symbola/effect-codegen codegen:check",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --project unit",
    "typecheck": "pnpm run build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "dprint": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.19.0"
}
