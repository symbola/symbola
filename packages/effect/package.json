{
  "name": "@symbola/effect",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "./src/**/*.ts",
    "./dist/**/*.js"
  ],
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./Effect": "./src/Effect.ts",
    "./Array": "./src/Array.ts",
    "./Chunk": "./src/Chunk.ts",
    "./Constructors": "./src/Constructors.ts",
    "./Exit": "./src/Exit.ts",
    "./HashMap": "./src/HashMap.ts",
    "./HashSet": "./src/HashSet.ts",
    "./Install": "./src/Install.ts",
    "./Option": "./src/Option.ts",
    "./Result": "./src/Result.ts",
    "./Schema": "./src/Schema.ts",
    "./SchemaValue": "./src/SchemaValue.ts",
    "./Stream": "./src/Stream.ts",
    "./Symbols": "./src/Symbols.ts",
    "./internal/*": null,
    "./*/index": null,
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.js",
      "./Effect": "./dist/Effect.js",
      "./Array": "./dist/Array.js",
      "./Chunk": "./dist/Chunk.js",
      "./Constructors": "./dist/Constructors.js",
      "./Exit": "./dist/Exit.js",
      "./HashMap": "./dist/HashMap.js",
      "./HashSet": "./dist/HashSet.js",
      "./Install": "./dist/Install.js",
      "./Option": "./dist/Option.js",
      "./Result": "./dist/Result.js",
      "./Schema": "./dist/Schema.js",
      "./SchemaValue": "./dist/SchemaValue.js",
      "./Stream": "./dist/Stream.js",
      "./Symbols": "./dist/Symbols.js",
      "./internal/*": null,
      "./*/index": null,
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --project unit",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
