{
  "name": "@symbola/effect-oxlint",
  "version": "4.0.0-beta.83-symbola.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/symbola/symbola.git",
    "directory": "packages/effect-oxlint"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./rules/*": "./src/rules/*.ts",
    "./internal/*": null
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./rules/*": "./dist/rules/*.js",
      "./internal/*": null
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --project unit",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@symbola/effect": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "symbola": {
    "targetEffect": "4.0.0-beta.83"
  }
}
